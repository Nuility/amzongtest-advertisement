apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: amazon-ads
  labels:
    app: amazon-ads
type: Opaque
stringData:
  DATABASE_USER: "<FROM_RAM_KMS:database_user>"
  DATABASE_PASSWORD: "<FROM_RAM_KMS:database_password>"
  
  REDIS_PASSWORD: "<FROM_RAM_KMS:redis_password>"
  
  JWT_SECRET_KEY: "<FROM_RAM_KMS:jwt_secret>"
  JWT_ALGORITHM: "HS256"
  JWT_EXPIRATION_HOURS: "24"
  
  AWS_ACCESS_KEY_ID: "<FROM_RAM_KMS:aws_access_key>"
  AWS_SECRET_ACCESS_KEY: "<FROM_RAM_KMS:aws_secret_key>"
  AWS_REGION: "us-east-1"
  
  SENTRY_DSN: "<FROM_RAM_KMS:sentry_dsn>"
  
note: |
  使用说明：
  1. 请将所有 <FROM_RAM_KMS:xxx> 替换为实际值
  2. 推荐使用云平台密钥管理服务（阿里云KMS/AWS Secrets Manager）
  3. 不要将此文件提交到版本控制系统
  4. 生产环境应使用Sealed Secrets或External Secrets
